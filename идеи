        /* Грид: 7 колонок по 100px, gap 16px, центрируем по горизонтали */
        .grid-container {
            display: grid;
            grid-template-columns: repeat(7, 100px);
            gap: 16px;
            justify-content: center;    /* выравнивание внутри .dashboard-grid (оставшиеся 4px равномерно по бокам) */
            margin: 0 auto;
        }

        /* Карточка элемента — ровно 100x100px */
        .grid-item {
            width: 100px;
            height: 100px;

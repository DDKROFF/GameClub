        }

        /* Текст под иконкой */
        .pc-label {
            font-size: 12px;
            font-weight: 700;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(2px);
            padding: 3px 8px;
            border-radius: 40px;
            color: white;
            letter-spacing: 0.3px;
            font-family: 'JetBrains Mono', monospace, 'Courier New';
            box-shadow: inset 0 0 2px rgba(255,255,255,0.4), 0 1px 2px rgba(0,0,0,0.2);
            transition: background 0.2s;
        }

        /* Панель управления для демонстрации работы с БД (имитация получения данных) */
        .demo-panel {
            margin-top: 32px;
            display: flex;
            justify-content: center;
            gap: 18px;
            flex-wrap: wrap;
        }

        .btn {

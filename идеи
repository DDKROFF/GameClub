            font-weight: 600;
            font-size: 0.9rem;
            color: white;
            cursor: pointer;
            transition: 0.2s;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: inherit;
        }

        .btn-primary {
            background: #0f4c5f;
            border-bottom: 2px solid #6ab0c6;
        }

        .btn-primary:hover {
            background: #1b6b85;
            transform: scale(0.98);
        }

        .btn-warning {
            background: #b4652d;
            border-bottom: 2px solid #ffb347;
        }

        .btn-warning:hover {
            background: #d47a3b;
        }

        .badge-info {
            background: #00000066;
            border-radius: 20px;
            padding: 2px 10px;
            font-size: 0.7rem;
            font-weight: normal;
        }

        footer {
            text-align: center;
            margin-top: 20px;
            font-size: 11px;
            color: #2c3e66;
            font-weight: 500;
            opacity: 0.8;
        }

        /* адаптив для очень узких экранов — скролл, но сетка сохранит размеры */
        @media (max-width: 860px) {
            body {
                padding: 16px;
            }
            .dashboard-grid {
                overflow-x: auto;
            }
            .grid-container {
                justify-content: flex-start;
                padding-left: 4px;

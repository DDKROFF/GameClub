        .dashboard-grid {
            max-width: 800px;
            width: 100%;
            background: rgba(255,255,255,0.3);
            backdrop-filter: blur(2px);
            border-radius: 32px;
            padding: 20px 0 20px 0;
            box-shadow: 0 20px 35px -12px rgba(0,0,0,0.2);
